<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console tool for the data pool and the G3 accuracy runs. Calls the same
    ExtractionPipeline the Worker will, so the accuracy it reports is the
    accuracy users get.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      Where `dotnet user-secrets` keeps this project's secrets (the Groq
      key): %APPDATA%\Microsoft\UserSecrets\<this id>\secrets.json, outside
      the repo. Not a secret itself.
    -->
    <UserSecretsId>plannr-eval-5b1f6c2e-3a8d-4f0e-9c71-2d4e8a6b9f13</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plannr.Core\Plannr.Core.csproj" />
    <ProjectReference Include="..\Plannr.Infrastructure\Plannr.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
