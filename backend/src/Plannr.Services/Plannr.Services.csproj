<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the API, the Worker and Eval share that isn't database code
    (Plannr.Data) or page fetching (Plannr.Scraping): the extraction logic,
    the Groq client, the DTOs and interfaces, options, exceptions, error
    references and logging setup. Folders follow Applr.Services (D41).

    The one rule the project boundary can't enforce: only APIs/ makes
    network calls. ArchitectureTests checks it on every build.
  -->

  <ItemGroup>
    <!-- Lets the tests call internal test hooks such as ErrorReference.Reset. -->
    <InternalsVisibleTo Include="Plannr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
