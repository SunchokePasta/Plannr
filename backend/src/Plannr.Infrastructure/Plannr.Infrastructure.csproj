<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Implementations of Plannr.Core's interfaces: page retrieval, the Groq
    client, and later EF Core and Playwright. Depends on Core, never the
    other way round.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Plannr.Core\Plannr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests use internal test hooks such as PlaywrightPageFetcher's request filter. -->
    <InternalsVisibleTo Include="Plannr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
